<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  TraceHunt - Hadoop core-site.xml Configuration Template
  Docker hostname for the existing master container: hadoop-master.
-->
<configuration>
    <property>
        <name>fs.defaultFS</name>
        <value>hdfs://hadoop-master:9000</value>
        <description>The NameNode URI where the Master coordinates the distributed file system.</description>
    </property>
    <property>
        <name>hadoop.tmp.dir</name>
        <value>/opt/hadoop_data/tmp</value>
        <description>Temporary Hadoop storage directory inside the demo container.</description>
    </property>
</configuration>
